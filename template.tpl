___TESTS___

scenarios:
- name: Native callback updates four keys and safely replaces partial input
  code: |-
    var callback;
    mock('injectScript', function (url, success) { success(); });
    mock('setInWindow', function (name, fn) { callback = fn; return true; });
    mockObject('templateStorage', {getItem: function () {}, setItem: function () {}});
    runCode({settingsId:'CYB-fixture001',regionList:'',waitForUpdateMs:500});
    callback({ad_storage:'granted',analytics_storage:'granted',ad_user_data:'granted',ad_personalization:'granted'});
    assertApi('updateConsentState').wasCalledWith({ad_storage:'granted',analytics_storage:'granted',ad_user_data:'granted',ad_personalization:'granted'});
    callback({analytics_storage:'denied'});
    assertApi('updateConsentState').wasCalledWith({ad_storage:'denied',analytics_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});
    assertApi('gtagSet').wasCalledWith('developer_id.dZTNmYW', true);
- name: Pending duplicate callers both succeed exactly once after one load
  code: |-
    var owner;
    var loaded;
    var failed;
    mockObject('templateStorage', {getItem:function () { return owner; },setItem:function (key,value) { owner=value; }});
    mock('setInWindow', function () { return true; });
    mock('injectScript', function (url,success,failure) { loaded=success;failed=failure; });
    runCode({settingsId:'CYB-fixture001',regionList:''});
    runCode({settingsId:'CYB-fixture001',regionList:''});
    assertThat(owner.waiters.length).isEqualTo(2);
    var firstResults=[];
    var secondResults=[];
    var first=owner.waiters[0];
    var second=owner.waiters[1];
    owner.waiters[0]=function (success) { firstResults.push(success);first(success); };
    owner.waiters[1]=function (success) { secondResults.push(success);second(success); };
    assertApi('gtmOnSuccess').wasNotCalled();
    assertApi('gtmOnFailure').wasNotCalled();
    loaded();loaded();failed();
    assertThat(firstResults.length).isEqualTo(1);
    assertThat(secondResults.length).isEqualTo(1);
    assertThat(firstResults[0]).isTrue();
    assertThat(secondResults[0]).isTrue();
    assertThat(owner.status).isEqualTo('loaded');
    assertThat(owner.waiters.length).isEqualTo(0);
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Pending duplicate failure denies and settles both callers once
  code: |-
    var owner;
    var loaded;
    var failed;
