    assertThat(owner.waiters.length).isEqualTo(2);
    var firstResults=[];
    var secondResults=[];
    var first=owner.waiters[0];
    var second=owner.waiters[1];
    owner.waiters[0]=function (success) { firstResults.push(success);first(success); };
    owner.waiters[1]=function (success) { secondResults.push(success);second(success); };
    assertApi('gtmOnSuccess').wasNotCalled();
    assertApi('gtmOnFailure').wasNotCalled();
    failed();failed();loaded();
    assertThat(firstResults.length).isEqualTo(1);
