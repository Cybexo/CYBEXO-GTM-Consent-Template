const log = require('logToConsole');
const injectScript = require('injectScript');
const gtagSet = require('gtagSet');
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const setInWindow = require('setInWindow');
const templateStorage = require('templateStorage');
const JSON = require('JSON');
const getType = require('getType');
const encodeUriComponent = require('encodeUriComponent');

var KEYS = ['ad_storage', 'analytics_storage', 'ad_user_data', 'ad_personalization'];
var LOADER = 'https://cmp.cybexo.com/loader.js';
var CDN = 'https://edge.cybexo.com';
var ASSETS = 'https://cmp.cybexo.com';
var DEVELOPER_ID = 'dZTNmYW';
var CALLBACK = 'cybexoGtmConsentUpdate';
var OWNER = 'cybexoConsentOwner';

function state(value, fallback) {
  var empty = value == null || (typeof value === 'string' && value.trim() === '');
  // JSON round-trip object inputs: inherited properties cannot become consent.
  var parsed = {};
  if (!empty) {
    if (typeof value === 'string') parsed = JSON.parse(value);
    else {
      var serialized = JSON.stringify(value);
      parsed = typeof serialized === 'string' ? JSON.parse(serialized) : undefined;
    }
  }
  var isObject = getType(parsed) === 'object';
  var output = {};
  for (var i = 0; i < KEYS.length; i++) {
    var key = KEYS[i];
    var candidate = isObject ? parsed[key] : undefined;
    output[key] = candidate === 'granted' || candidate === 'denied' ? candidate
      : (fallback && (empty || (isObject && candidate === undefined)) ? fallback[key] : 'denied');
  }
  return output;
}
// Dashboard apps-server.js generates CYB- followed by 10 lowercase base-36 characters.
function isValidSettingsId(value) {
  if (value.length !== 14 || value.slice(0, 4) !== 'CYB-') return false;
  var chars = '0123456789abcdefghijklmnopqrstuvwxyz';
  for (var i = 4; i < value.length; i++) if (chars.indexOf(value.charAt(i)) === -1) return false;
  return true;
}
function regions(csv) {
  var parts = typeof csv === 'string' ? csv.split(',') : [];
  var output = [];
  for (var i = 0; i < parts.length; i++) {
    var region = parts[i].trim().toUpperCase();
    if (region && output.indexOf(region) === -1) output.push(region);
  }
  return output;
}
function deny() { updateConsentState(state(null)); }
function settle(owner, status) {
  if (owner.status !== 'pending') return;
  owner.status = status;
  var waiters = owner.waiters;
  owner.waiters = [];
  if (status === 'failed') deny();
  for (var i = 0; i < waiters.length; i++) waiters[i](status === 'loaded');
}

(function main() {
  var completed = false;
  function finish(success) {
    if (completed) return;
    completed = true;
    if (success) data.gtmOnSuccess();
    else data.gtmOnFailure();
  }
  var settingsId = typeof data.settingsId === 'string' ? data.settingsId.trim() : '';
  var validId = isValidSettingsId(settingsId);
  var identityError = settingsId.slice(0, 4) === 'NXG-'
    ? 'Legacy NXG App IDs are retired in this template. Migrate the app in CYBEXO and copy its CYB App ID; do not rename the prefix. Reload after updating the tag.'
    : 'A valid CYB App ID is required. Copy the CYB- ID with 10 lowercase letters or digits from the CYBEXO dashboard.';
  var owner = templateStorage.getItem(OWNER);
  if (owner) {
    if (!validId || owner.settingsId !== settingsId) {
      log('Cybexo CMP: ' + (validId ? 'Conflicting Settings IDs. Consent remains denied; correct configuration and reload.' : identityError));
      if (owner.status === 'pending') settle(owner, 'failed');
      else { owner.status = 'failed'; deny(); }
      finish(false);
      return;
    }
    // Repeated triggers neither replace defaults nor reset an existing choice.
    if (owner.status === 'pending') owner.waiters.push(finish);
    else finish(owner.status === 'loaded');
    return;
  }
  var wait = data.waitForUpdateMs * 1;
  if (!(wait >= 500 && wait <= 10000)) wait = 500;
  var defaults = validId ? state(data.globalDefaultsJson) : state(null);
  defaults.wait_for_update = wait;
  gtagSet('developer_id.' + DEVELOPER_ID, true);
  setDefaultConsentState(defaults);
  if (!validId) {
    log('Cybexo CMP: ' + identityError);
    deny();
    finish(false);
    return;
  }
  var regionList = regions(data.regionList);
  if (regionList.length) {
    var regional = state(data.regionDefaultsJson, defaults);
    regional.region = regionList;
    regional.wait_for_update = wait;
    setDefaultConsentState(regional);
  }
  owner = {settingsId: settingsId, status: 'pending', waiters: [finish]};
  // Register the native update owner before the asynchronous loader can run.
  var registered = setInWindow(CALLBACK, function (signals) {
    if (owner.status === 'failed') return false;
    updateConsentState(state(signals));
    return true;
  }, false);
  if (!registered) {
    log('Cybexo CMP: Consent callback already exists. Consent remains denied; correct configuration and reload.');
    settle(owner, 'failed');
    return;
  }
  templateStorage.setItem(OWNER, owner);
  var url = LOADER + '?delivery=2&data-settings-id=' + encodeUriComponent(settingsId)
    + '&data-cdn-url=' + encodeUriComponent(CDN)
    + '&data-assets-url=' + encodeUriComponent(ASSETS)
    + '&data-developer-id=' + DEVELOPER_ID + '&data-consent-mode=off';
  injectScript(url, function () {
    // Download completion is separate from configuration/GVL/CMP readiness.
    settle(owner, 'loaded');
  }, function () {
    log('Cybexo CMP: Loader failed. Consent remains denied; reload to retry.');
    settle(owner, 'failed');
  }, 'cybexo-cmp-' + settingsId);
})();


